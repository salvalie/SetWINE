find_openbox_rc() {
    if [ -f "$HOME/.config/openbox/rc.xml" ]; then
        echo "$HOME/.config/openbox/rc.xml"
        return 0
    fi
    local candidate
    for candidate in "$HOME/.config/openbox/"*rc.xml; do
        if [ -f "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

collect_game_shortcuts() {
    local dirs=()
    local desktop_dir
    desktop_dir="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
    dirs+=("$desktop_dir" "$HOME/.local/share/applications")

    local f exec_line script
    for d in "${dirs[@]}"; do
        [[ -d "$d" ]] || continue
        for f in "$d"/*.desktop; do
            [[ -f "$f" ]] || continue
            if grep -q '\.local/bin/wine' "$f" 2>/dev/null; then
                echo "$f"
                continue
            fi
            exec_line=$(grep -m1 '^Exec=' "$f" 2>/dev/null | sed -E 's/^Exec="?([^";]*\.sh)"?.*/\1/')
            if [[ -n "$exec_line" && -f "$exec_line" ]] && grep -q '\.local/bin/wine' "$exec_line" 2>/dev/null; then
                echo "$f"
            fi
        done
    done | sort -u
}

strip_path_block() {
    local f="$1"
    [[ -f "$f" ]] || return 0
    grep -q '^# Add user local binaries to PATH$' "$f" && \
        sed -i '\|^# Add user local binaries to PATH$|,/^fi$/d' "$f"
    grep -qF 'export PATH="$HOME/.local/bin:$PATH"' "$f" && \
        sed -i '\|export PATH="\$HOME/\.local/bin:\$PATH"|d' "$f"
}

revert_hotkeys() {
    local de
    de=$(detect_desktop_environment)

    case "$de" in
        gnome)
            if command -v gsettings >/dev/null 2>&1 && \
               gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null | grep -q 'wine-killer'; then
                local cur new
                cur=$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings)
                new=$(printf '%s' "$cur" \
                    | sed -e "s#['\"]*/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/['\"]*,\s*##" \
                          -e "s#,\s*['\"]*/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/['\"]*##" \
                          -e "s#['\"]*/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/['\"]*#@as []#")
                gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$new" 2>>"$LOGFILE"
                if command -v dconf >/dev/null 2>&1; then
                    dconf reset -f /org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/ 2>>"$LOGFILE"
                fi
                sub_ok "removed GNOME hotkey"
            else
                sub_status "no GNOME hotkey found"
            fi
            ;;
        cinnamon)
            if command -v gsettings >/dev/null 2>&1 && \
               gsettings get org.cinnamon.desktop.keybindings.custom-keybinding:/org/cinnamon/desktop/keybindings/custom-keybindings/custom0/ command 2>/dev/null | grep -q 'wineserver'; then
                if command -v dconf >/dev/null 2>&1; then
                    dconf reset -f /org/cinnamon/desktop/keybindings/custom-keybindings/custom0/ 2>>"$LOGFILE"
                fi
                local list
                list=$(gsettings get org.cinnamon.desktop.keybindings custom-list 2>/dev/null)
                if [[ "$list" == "['custom0']" ]]; then
                    gsettings set org.cinnamon.desktop.keybindings custom-list "@as []" 2>>"$LOGFILE"
                fi
                sub_ok "removed Cinnamon hotkey"
            else
                sub_status "no Cinnamon hotkey found"
            fi
            ;;
        xfce)
            if command -v xfconf-query >/dev/null 2>&1 && \
               xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Primary><Alt>Q" >/dev/null 2>&1; then
                xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/<Primary><Alt>Q" -r 2>>"$LOGFILE"
                sub_ok "removed XFCE hotkey"
            else
                sub_status "no XFCE hotkey found"
            fi
            ;;
        openbox)
            local rc
            if rc=$(find_openbox_rc); then
                if grep -q 'wineserver -k' "$rc"; then
                    awk '/<keybind key="C-A-Q">/ {skip=1; next}
                         skip && /<\/keybind>/ {skip=0; next}
                         !skip {print}' "$rc" > "$rc.tmp" && mv "$rc.tmp" "$rc"
                    pgrep -x openbox >/dev/null 2>&1 && openbox --reconfigure >>"$LOGFILE" 2>&1
                    sub_ok "removed Openbox hotkey ($rc)"
                else
                    sub_status "no Openbox hotkey found"
                fi
            else
                sub_status "no Openbox config found"
            fi
            ;;
        mangowm)
            local keybinds_file="$HOME/.config/mango/cfg/keybinds.conf"
            if [[ -f "$keybinds_file" ]] && grep -q 'wineserver -k' "$keybinds_file"; then
                sed -i '/# Wine killer/,+2d' "$keybinds_file" 2>>"$LOGFILE"
                sub_ok "removed Mango WM hotkey"
            else
                sub_status "no Mango WM hotkey found"
            fi
            ;;
        hyprland)
            local hypr_config=""
            if [[ -f "$HOME/.config/hypr/hyprland.conf" ]]; then
                hypr_config="$HOME/.config/hypr/hyprland.conf"
            elif [[ -d "$HOME/.config/hypr" ]]; then
                for candidate in "$HOME/.config/hypr/"*.conf; do
                    if [[ -f "$candidate" ]]; then hypr_config="$candidate"; break; fi
                done
            fi
            if [[ -n "$hypr_config" ]] && grep -q 'wineserver -k' "$hypr_config"; then
                sed -i '/# Wine killer/,+2d' "$hypr_config" 2>>"$LOGFILE"
                sub_ok "removed Hyprland hotkey"
            else
                sub_status "no Hyprland hotkey found"
            fi
            ;;
        *)
            sub_status "desktop '$de': nothing to revert"
            ;;
    esac
}

main_uninstall() {
    STEP_NUM=0
    STEP_TOTAL=8
    banner
    cecho "  This will revert everything SetWINE did:"
    echo ""

    local items=()
    shopt -s nullglob
    local binfiles=( "$HOME/.local/bin"/wine* "$HOME/.local/bin/winetricks" "$HOME/.local/bin/winemode" )
    shopt -u nullglob
    if ((${#binfiles[@]})); then
        mapfile -t binfiles < <(printf '%s\n' "${binfiles[@]}" | sort -u)
        items+=("binaries: ${binfiles[*]#$HOME/}")
    fi
    [[ -d "$HOME/.local/wine" ]] && items+=("directory: ~/.local/wine")
    [[ -f "$HOME/.local/share/applications/wine.desktop" ]] && items+=("desktop entries: ~/.local/share/applications/wine*.desktop")
    [[ -f "$HOME/.local/share/icons/wine.svg" ]] && items+=("icons: ~/.local/share/icons/wine*.svg")
    [[ -f "$HOME/.config/mimeapps.list" ]] && items+=(".exe/.msi file associations")
    [[ -f "$HOME/.profile" || -f "$HOME/.xprofile" ]] && items+=("PATH lines in ~/.profile and ~/.xprofile")
    items+=("keyboard shortcut (Ctrl+Alt+Q) for your desktop")
    [[ -d "$HOME/.cache/winetricks" ]] && items+=("KEPT as requested: ~/.cache/winetricks")

    local it
    for it in "${items[@]}"; do
        [[ "$it" == KEPT* ]] && { yecho "    ~ $it"; continue; }
        echo "    - $it"
    done
    echo ""
    if [[ -z "${REMOVE_PREFIX:-}" ]]; then
        yecho "    ? Your Wine prefix ~/.wine (installed programs, saved games):"
        if confirm "remove the prefix too?" "n"; then
            REMOVE_PREFIX=1
            echo "    - prefix: ~/.wine (confirmed)"
        else
            REMOVE_PREFIX=0
            yecho "    ~ KEPT: ~/.wine"
        fi
    elif (( REMOVE_PREFIX )); then
        echo "    - prefix: ~/.wine (will be removed)"
    else
        echo "    ~ prefix: ~/.wine (kept)"
    fi
    echo ""

    confirm "Proceed with uninstall?" "n" || { yecho "  Aborted."; exit 0; }
    echo ""

    step_begin "Stopping any running Wine processes"
    [[ -x "$HOME/.local/bin/wineserver" ]] && "$HOME/.local/bin/wineserver" -k >/dev/null 2>&1
    sleep 1
    step_done

    step_begin "Removing binaries from ~/.local/bin"
    shopt -s nullglob
    local files=( "$HOME/.local/bin"/wine* "$HOME/.local/bin/winetricks" "$HOME/.local/bin/winemode" )
    shopt -u nullglob
    if ((${#files[@]})); then
        mapfile -t files < <(printf '%s\n' "${files[@]}" | sort -u)
        rm -f "${files[@]}"
        sub_ok "removed ${#files[@]} files"
    else
        sub_status "nothing to remove"
    fi
    step_done

    step_begin "Removing Wine build (~/.local/wine)"
    if [[ -d "$HOME/.local/wine" ]]; then rm -rf "$HOME/.local/wine"; sub_ok "removed"; else sub_status "not present"; fi
    step_done

    step_begin "Removing Wine prefix (~/.wine)"
    if [[ "$REMOVE_PREFIX" == 1 && -d "$HOME/.wine" ]]; then
        rm -rf "$HOME/.wine"
        sub_ok "removed"
    else
        sub_status "kept"
    fi
    step_done

    step_begin "Removing desktop entry and file associations"
    local apps_dir="$HOME/.local/share/applications"
    local desktop_files=("wine.desktop" "winecfg.desktop" "ddraw-config.desktop" "wineshortcut.desktop")
    local df removed=0
    for df in "${desktop_files[@]}"; do
        if [[ -f "$apps_dir/$df" ]]; then
            rm -f "$apps_dir/$df"
            ((removed++))
        fi
    done
    if (( removed > 0 )); then
        update-desktop-database "$apps_dir" >>"$LOGFILE" 2>&1
        sub_ok "removed $removed .desktop files"
    else
        sub_status "no SetWINE .desktop files found"
    fi
    if [[ -f "$HOME/.config/mimeapps.list" ]]; then
        sed -i -E '\#^(application/(x-ms-dos-executable|x-msdownload|x-msi|x-ms-shortcut|x-bat|x-mswinurl)|application/vnd\.microsoft\.portable-executable)[[:space:]]*=wine\.desktop#d' \
            "$HOME/.config/mimeapps.list"
        sub_ok "cleaned ~/.config/mimeapps.list"
    fi
    step_done

    step_begin "Removing Wine icons from ~/.local/share/icons"
    local icons_dir="$HOME/.local/share/icons"
    local icon_files=("wine.svg" "winecfg.svg" "wineshortcut.svg" "ddraw-config.svg")
    local ic removed_icons=0
    for ic in "${icon_files[@]}"; do
        if [[ -f "$icons_dir/$ic" ]]; then
            rm -f "$icons_dir/$ic"
            ((removed_icons++))
        fi
    done
    if (( removed_icons > 0 )); then
        sub_ok "removed $removed_icons icons"
    else
        sub_status "no SetWINE icons found"
    fi
    step_done

    step_begin "Reverting keyboard shortcut"
    revert_hotkeys
    step_done

    step_begin "Cleaning PATH lines from shell profiles"
    strip_path_block "$HOME/.profile"
    strip_path_block "$HOME/.xprofile"
    sub_ok "profiles cleaned"
    step_done

    step_begin "Checking for leftover game shortcuts"
    local leftovers=()
    mapfile -t leftovers < <(collect_game_shortcuts)
    if ((${#leftovers[@]})); then
        local sc
        for sc in "${leftovers[@]}"; do echo "         found: $sc"; done
        if confirm "Remove these shortcuts (their launchers point to removed wine)?" "n"; then
            rm -f "${leftovers[@]}"
            sub_ok "removed ${#leftovers[@]} shortcuts"
        else
            sub_status "left in place"
        fi
    else
        sub_status "none found"
    fi
    step_done

    echo ""
    gecho "=========== UNINSTALL COMPLETED ==========="
    decho "winetricks cache kept in ~/.cache/winetricks (delete manually if you want)."
    decho "Detailed log: $LOGFILE"
    echo ""
}

########################################################################################
# Dispatch
########################################################################################

usage() {
    awk 'NR>1 && /^####/ {exit} NR>1 {sub(/^# ?/, ""); print}' "$0"
}

main() {
    local args=()
    local a
    for a in "$@"; do
        case "$a" in
            -v|--verbose) VERBOSE=1 ;;
            *) args+=("$a") ;;
        esac
    done

    local cmd="${args[0]:-install}"
    case "$cmd" in
        install)   main_loop ;;
        uninstall) main_uninstall ;;
        help|-h|--help) usage ;;
        *)
            recho "Unknown command: $cmd"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
