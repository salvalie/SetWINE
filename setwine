install_d7vk() {
    step_begin "Installing d7vk (DirectX 2-7 Vulkan wrapper)"
    local syswow64="$HOME/.wine/drive_c/windows/syswow64"
    local archive="$LOGDIR/d7vk.zip"

    if [[ ! -d "$syswow64" ]]; then
        step_done
        yecho "  syswow64 not found, skipping d7vk."
        return 0
    fi

    # Fetch latest release URL from GitHub API
    start_spinner "looking up latest d7vk release"
    local api_response
    api_response=$(wget -qO- "https://api.github.com/repos/WinterSnowfall/d7vk/releases/latest" 2>/dev/null)
    local d7vk_tag d7vk_url
    d7vk_tag=$(printf '%s' "$api_response" | grep -oP '"tag_name":\s*"\K[^"]+' | head -1)
    d7vk_url=$(printf '%s' "$api_response" | grep -oP '"browser_download_url":\s*"\K[^"]+\.zip' | head -1)
    stop_spinner

    if [[ -z "$d7vk_url" ]]; then
        stop_spinner
        step_fail
        yecho "  Could not fetch latest d7vk release from GitHub."
        return 0
    fi

    # Rename cnc-ddraw's ddraw.dll to ddraw_.dll so d7vk can fall back to it
    if [[ -f "$syswow64/ddraw.dll" ]] && ! [[ -f "$syswow64/ddraw_.dll" ]]; then
        mv "$syswow64/ddraw.dll" "$syswow64/ddraw_.dll"
        sub_ok "renamed cnc-ddraw ddraw.dll -> ddraw_.dll"
    fi

    start_spinner "downloading d7vk $d7vk_tag"
    echo "+ wget $d7vk_url" >> "$LOGFILE"
    if wget -q -O "$archive" "$d7vk_url" >>"$LOGFILE" 2>&1; then
        stop_spinner
    else
        stop_spinner
        step_fail
        yecho "  Failed to download d7vk."
        return 0
    fi

    start_spinner "extracting d7vk"
    local tmpdir
    tmpdir="$(mktemp -d)"
    echo "+ unzip $archive -d $tmpdir" >> "$LOGFILE"
    if ! unzip -q -o "$archive" -d "$tmpdir" >>"$LOGFILE" 2>&1; then
        rm -f "$archive"
        rm -rf "$tmpdir"
        stop_spinner
        step_fail
        yecho "  Failed to extract d7vk archive."
        return 0
    fi
    rm -f "$archive"

    echo "+ find $tmpdir -name ddraw.dll" >> "$LOGFILE"
    find "$tmpdir" -name 'ddraw.dll' -type f >> "$LOGFILE" 2>&1

    # Find x32 ddraw.dll anywhere in the extracted tree
    local d7vk_ddraw
    d7vk_ddraw="$(find "$tmpdir" -path '*/x32/ddraw.dll' -type f 2>/dev/null | head -1)"
    if [[ -z "$d7vk_ddraw" ]]; then
        d7vk_ddraw="$(find "$tmpdir" -name 'ddraw.dll' -type f 2>/dev/null | head -1)"
    fi

    if [[ -z "$d7vk_ddraw" || ! -f "$d7vk_ddraw" ]]; then
        rm -rf "$tmpdir"
        step_fail
        yecho "  Could not find ddraw.dll in d7vk archive."
        return 0
    fi

    cp "$d7vk_ddraw" "$syswow64/ddraw.dll"
    rm -rf "$tmpdir"
    stop_spinner
    step_done
    sub_ok "d7vk ddraw.dll ($d7vk_tag) installed to syswow64"
    sub_status "cnc-ddraw available as ddraw_.dll (fallback for ddraw-only games)"
}

