#!/usr/bin/env bash
#
# ===========================================================================================
#  SetWINE - opinionated HOME located Wine environment for Linux Distros (no root needed)
# ===========================================================================================
#
#  DESCRIPTION
#    Downloads a self-contained Wine build (staging-tkg ntsync or Proton,
#    WoW64) into ~/.local/wine and wires up everything around it, all inside
#    your home directory:
#
#      ~/.local/wine                               the Wine build itself
#      ~/.local/bin/wine                           wrapper: fsync, mangohud,
#                                                  native d3d dll overrides,
#                                                  systemd-inhibit sleep/idle
#      ~/.local/bin/winecfg,wineserver,wineboot    symlinks to the build
#      ~/.local/bin/winetricks                     latest upstream, unattended
#      ~/.local/bin/wined                          run an exe with full log +
#                                                  filtered error log
#      ~/.local/bin/winemode                       switch wine graphics driver
#                                                  between wayland <-> x11
#      ~/.local/bin/wineshortcut                turn any .exe into a desktop
#                                                  shortcut with extracted icon
#      ~/.local/share/applications/wine.desktop    .exe/.msi double-click handler
#      ~/.wine                                     fresh Wine prefix (C: drive)
#      DXVK + VKD3D                                via winetricks, your choice
#      Ctrl+Alt+Q                                  "wine killer": wineserver -k
#
#    Re-running it replaces Wine but never touches your prefix (~/.wine).
#    All noisy output (wget, winetricks, cabextract...) goes to a log file in
#    ~/.cache/setwine/ unless you pass -v.
#
#  USAGE
#    setwine                 interactive installation
#    setwine -v              same, echoing every underlying command live
#    setwine --verbose       alias of -v
#    setwine uninstall       revert everything SetWINE did, except
#                            ~/.cache/winetricks (kept on purpose)
#    setwine help            show this help
#
#  EXAMPLES
#    ./setwine                          full guided setup
#    ./setwine -v                       watch raw wget/winetricks output
#    ./setwine uninstall                clean slate, winetricks cache kept
#
#############################################################################################

GREEN=$'\033[0;32m'; RED=$'\033[0;31m'; YELLOW=$'\033[0;33m'; CYAN=$'\033[0;36m'
BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

USE_COLOR=0
if [[ -t 1 ]]; then USE_COLOR=1; else GREEN='' RED='' YELLOW='' CYAN='' BOLD='' DIM='' RESET=''; fi

gecho(){ printf '%b\n' "${GREEN}$*${RESET}"; }
recho(){ printf '%b\n' "${RED}$*${RESET}" >&2; }
yecho(){ printf '%b\n' "${YELLOW}$*${RESET}"; }
cecho(){ printf '%b\n' "${CYAN}$*${RESET}"; }
decho(){ printf '%b\n' "${DIM}$*${RESET}"; }

VERBOSE=0
LOGDIR="$HOME/.cache/setwine"
mkdir -p "$LOGDIR"
LOGFILE="$LOGDIR/install-$(date +%Y%m%d-%H%M%S).log"

SPINNER_PID=""
CURSOR_HIDDEN=0
CURRENT_STEP=""

cleanup() {
    local sig="${1:-}"
    kill_spinner_only
    if (( CURSOR_HIDDEN )); then printf '\e[?25h'; CURSOR_HIDDEN=0; fi
    if [[ "$sig" == "INT" || "$sig" == "TERM" ]]; then
        echo ""
        die "Interrupted by user."
    fi
}
trap cleanup EXIT
trap 'cleanup INT' INT
trap 'cleanup TERM' TERM

kill_spinner_only() {
    if [[ -n "$SPINNER_PID" ]]; then
        kill "$SPINNER_PID" 2>/dev/null
        wait "$SPINNER_PID" 2>/dev/null
        SPINNER_PID=""
    fi
}

clr_line() {
    if (( USE_COLOR )); then printf '\r\033[K'; else printf '\r'; fi
}

start_spinner() {
    local msg="$1"
    (( USE_COLOR )) || return 0
    kill_spinner_only
    SPUN=1
    printf '\e[?25l'; CURSOR_HIDDEN=1
    (
        local frames='|/-\' i=0 start=$SECONDS
        while :; do
            printf '\r     %s%s %s (%ds)%s' \
                "$DIM" "${frames:i++%4:1}" "$msg" "$((SECONDS - start))" "$RESET"
            sleep 0.12
        done
    ) &
    SPINNER_PID=$!
}

stop_spinner() {
    kill_spinner_only
    clr_line
}

show_cursor_for_prompt() {
    kill_spinner_only
    clr_line
    if (( CURSOR_HIDDEN )); then printf '\e[?25h'; CURSOR_HIDDEN=0; fi
    LINE_OPEN=0
}

STEP_NUM=0
STEP_TOTAL=12
LINE_OPEN=0
SPUN=0
LABEL_PREFIX=""
STEP_CLOSED=0

step_begin() {
    show_cursor_for_prompt
    STEP_NUM=$((STEP_NUM + 1))
    CURRENT_STEP="$1"
    LABEL_PREFIX=$(printf '  %s[%2d/%2d]%s %s' "$CYAN" "$STEP_NUM" "$STEP_TOTAL" "$RESET" "$1")
    printf '%s ' "$LABEL_PREFIX"
    LINE_OPEN=1
    SPUN=0
    STEP_CLOSED=0
}

finish_step() {
    local color="$1" tag="$2"
    kill_spinner_only
    if (( SPUN )); then clr_line; fi
    if (( LINE_OPEN )); then
        printf ' %s[%s]%s\n' "$color" "$tag" "$RESET"
    elif (( SPUN )); then
        printf '%s %s[%s]%s\n' "$LABEL_PREFIX" "$color" "$tag" "$RESET"
    else
        printf '        %s[%s]%s\n' "$color" "$tag" "$RESET"
    fi
    LINE_OPEN=0
    SPUN=0
    STEP_CLOSED=1
}

step_done() { finish_step "$GREEN" "ok"; }
step_fail() { finish_step "$RED" "FAIL"; }

close_label_line() {
    if (( LINE_OPEN )); then printf '\n'; LINE_OPEN=0; fi
}
sub_status(){ close_label_line; printf '         %s- %s%s\n' "$DIM" "$1" "$RESET"; }
sub_ok(){     close_label_line; printf '         %s+ %s%s\n' "$GREEN" "$1" "$RESET"; }
sub_fail(){   close_label_line; printf '         %sx %s%s\n' "$RED" "$1" "$RESET"; }

die() {
    if (( STEP_CLOSED )); then
        close_label_line
        printf '         %sx %s%s\n' "$RED" "$1" "$RESET"
    else
        step_fail
        printf '         %sx %s%s\n' "$RED" "$1" "$RESET"
    fi
    recho ""
    recho "Error: $1"
    recho "Full details: $LOGFILE"
    exit 1
}

confirm() {
    local question="$1" default="${2:-n}" answer=""
    show_cursor_for_prompt
    if [[ "$default" == "y" ]]; then
        if ! read -rp "$(printf '%b' "  $question ${DIM}[Y/n]${RESET} ")" answer; then
            printf '\n'
            return 1
        fi
        [[ -z "$answer" || "$answer" =~ ^[Yy] ]]
    else
        if ! read -rp "$(printf '%b' "  $question ${DIM}[y/N]${RESET} ")" answer; then
            printf '\n'
            return 1
        fi
        [[ "$answer" =~ ^[Yy] ]]
    fi
}

banner() {
    echo ""
    cecho "=================================================================================="
    cecho "   SetWINE :: opinionated HOME Wine environment for Linux Distros (no root needed)"
    cecho "=================================================================================="
    decho "   Detailed log: $LOGFILE"
    echo ""
}

##############################################################################################
# Checks
##############################################################################################

check_internet() {
    step_begin "Checking internet connection"
    start_spinner "pinging www.google.com"
    if ping -q -c 2 -W 2 www.google.com >/dev/null 2>&1; then
        stop_spinner
        step_done
        return 0
    fi
    # ICMP may be blocked; fall back to a plain HTTP check
    stop_spinner
    sub_status "ping failed, trying HTTP check..."
    if wget -q --spider --timeout=6 --tries=1 https://www.google.com >/dev/null 2>&1 \
       || { command -v curl >/dev/null 2>&1 && curl -fsS --max-time 6 -o /dev/null https://www.google.com >/dev/null 2>&1; }; then
        step_done
        return 0
    fi
    die "No internet connection."
}

check_architecture() {
    step_begin "Checking architecture"
    if [[ "$(uname -m)" != "x86_64" && "$(uname -m)" != "amd64" ]]; then
        die "You are not on amd64/x86_64 architecture."
    fi
    step_done
}

check_wine_installed() {
    step_begin "Checking for existing Wine installations"

    if command -v wine >/dev/null 2>&1 && [[ "$(command -v wine)" != "$HOME/.local/bin/wine" ]]; then
        die "Wine is already installed globally on this system. Remove it first (or use 'setwine uninstall')."
    fi

    if [[ ! -d "$HOME/.local/wine" ]]; then
        step_done
        return 0
    fi

    step_done
    yecho "  A previous SetWINE installation exists in ~/.local/wine."
    echo ""
    cecho "  What would you like to do?"
    echo ""
    echo "    1) Remove old Wine build and install new one (keep ~/.wine prefix)"
    echo "    2) Remove old Wine build AND ~/.wine prefix, then install fresh"
    if [[ -d "$HOME/.wine" ]]; then
        yecho "       WARNING: ~/.wine is your C: drive with installed programs and data."
    fi
    echo "    3) Uninstall SetWINE completely"
    echo "    4) Abort installation"
    echo ""

    local option
    while :; do
        if ! read -rp "  Number [1-4]: " option; then
            printf '\n'
            die "Input stream closed."
        fi
        case "$option" in
            1)
                yecho "  Your prefix (~/.wine) will NOT be touched."
                rm -rf "$HOME/.local/wine"
                return 0
                ;;
            2)
                if [[ -d "$HOME/.wine" ]]; then
                    yecho "  WARNING: This will DELETE ~/.wine (your C: drive)."
                    yecho "  All installed Windows programs and saved data will be lost."
                    echo ""
                    if ! confirm "Are you sure?"; then
                        yecho "  Aborted."
                        return 1
                    fi
                fi
                rm -rf "$HOME/.local/wine"
                rm -rf "$HOME/.wine"
                return 0
                ;;
            3)
                echo ""
                REMOVE_PREFIX=0
                if [[ -d "$HOME/.wine" ]]; then
                    yecho "  ~/.wine is your Wine prefix (C: drive)."
                    yecho "  This contains installed programs, saved games, and user data."
                    echo ""
                    if confirm "Remove ~/.wine prefix too?"; then
                        REMOVE_PREFIX=1
                    fi
                fi
                echo ""
                main_uninstall
                echo ""
                gecho "=========== UNINSTALL COMPLETED ==========="
                echo ""
                exit 0
                ;;
            4)
                die "Aborted by user."
                ;;
            *)
                yecho "  Invalid option, try again."
                ;;
        esac
    done
}

check_dependencies() {
    step_begin "Checking system dependencies"
    local missing=()
    local missing_names=()

    if ! command -v cabextract >/dev/null 2>&1; then
        missing+=("cabextract")
        missing_names+=("cabextract")
    fi
    if ! command -v unzip >/dev/null 2>&1; then
        missing+=("unzip")
        missing_names+=("unzip")
    fi
    if ! command -v wrestool >/dev/null 2>&1; then
        missing+=("icoutils")
        missing_names+=("icoutils (wrestool)")
    fi
    if ! command -v convert >/dev/null 2>&1 || ! command -v identify >/dev/null 2>&1; then
        missing+=("imagemagick")
        missing_names+=("imagemagick (convert, identify)")
    fi

    if (( ${#missing[@]} == 0 )); then
        step_done
        return 0
    fi

    printf ' %s\n' "${missing_names[@]}" | while read -r n; do
        sub_status "missing: $n"
    done

    local pkg_mgr=""
    if command -v pacman >/dev/null 2>&1; then
        pkg_mgr="pacman"
    elif command -v apt >/dev/null 2>&1; then
        pkg_mgr="apt"
    elif command -v dnf >/dev/null 2>&1; then
        pkg_mgr="dnf"
    fi

    if [[ -z "$pkg_mgr" ]]; then
        step_done
        yecho "  Could not detect pacman/apt/dnf."
        yecho "  Please install manually: ${missing[*]}"
        return 1
    fi

    if ! confirm "Install missing packages with sudo?"; then
        step_done
        yecho "  Skipped. Install manually: ${missing[*]}"
        return 1
    fi

    local pm_install=""
    case "$pkg_mgr" in
        pacman)
            pm_install="sudo pacman -S --needed --noconfirm ${missing[*]}"
            ;;
        apt)
            pm_install="sudo apt install -y ${missing[*]}"
            ;;
        dnf)
            pm_install="sudo dnf install -y ${missing[*]}"
            ;;
    esac

    echo "" >> "$LOGFILE"
    echo "+ $pm_install" >> "$LOGFILE"
    if eval "$pm_install" >>"$LOGFILE" 2>&1; then
        step_done
    else
        step_done
        yecho "  Package installation failed. Check log: $LOGFILE"
        return 1
    fi
}

general_check() {
    check_internet
    check_architecture
    check_wine_installed
    check_dependencies || die "Required dependencies not satisfied. Install them manually and try again."
}

prepare_environment() {
    local bin="$HOME/.local/bin"
    mkdir -p "$bin"
    [[ ":$PATH:" == *":$bin:"* ]] || export PATH="$bin:$PATH"

    # winetricks internally invokes wine/wineserver by name; pin them to our
    # install so a stale/missing PATH can never stall the verb installs.
    # (The build is placed at these paths early in main_loop.)
    export WINE="$HOME/.local/wine/bin/wine"
    export WINESERVER="$HOME/.local/wine/bin/wineserver"
}

##############################################################################################
# Wine download / installation
##############################################################################################

fetch_build_urls() {
    local answer all
    answer=$(wget -qO- "https://api.github.com/repos/Kron4ek/Wine-Builds/releases") || true
    [[ -n "$answer" ]] || return 1

    all=$(printf '%s\n' "$answer" \
        | grep -oE '"browser_download_url": ?"[^"]*(staging-tkg(-ntsync)?-amd64-wow64|wine-proton-[0-9]+\.[0-9]+(-[0-9]+)?-amd64-wow64)\.tar\.xz"' \
        | sed -E 's/.*"([^"]+)"/\1/')
    [[ -n "$all" ]] || return 1

    printf '%s\n' "$all" | grep -v proton | sort -V -r -u
    printf '%s\n' "$all" | grep proton | sort -V -r -u
}

pretty_name() {
    basename "$1" | sed -E 's/\.tar\.xz$//'
}

install_wine() {
    step_begin "Looking up available Wine builds (ntsync / Proton)"
    mapfile -t urls < <(fetch_build_urls)
    urls=($(printf '%s\n' "${urls[@]}" | grep -E '^https?://' || true))
    if (( ${#urls[@]} == 0 )); then
        die "No available Wine versions found (GitHub unreachable?)."
    fi
    step_done

    show_cursor_for_prompt
    cecho "  Select the Wine version to install:"
    local i=1 name
    for url in "${urls[@]}"; do
        name="$(pretty_name "$url")"
        if [[ "$name" == *proton* ]]; then
            printf '    %s%2d)%s %s  %s(proton)%s\n' "$BOLD" "$i" "$RESET" "$name" "$DIM" "$RESET"
        else
            printf '    %s%2d)%s %s\n' "$BOLD" "$i" "$RESET" "$name"
        fi
        ((i++))
    done

    local option url
    while :; do
        if ! read -rp "  Number [1-${#urls[@]}]: " option; then
            printf '\n'
            die "Input stream closed."
        fi
        if [[ "$option" =~ ^[1-9][0-9]*$ ]] && (( option >= 1 && option <= ${#urls[@]} )); then
            break
        fi
        yecho "  Invalid option, try again."
    done
    url="${urls[$((option-1))]}"
    decho "  Selected: $url"

    local target="$HOME/.local/wine" archive="$LOGDIR/wine.tar.xz"
    [[ -d "$target" ]] && rm -rf "$target"

    step_begin "Downloading $(pretty_name "$url")"
    start_spinner "downloading"
    if (( VERBOSE )); then
        wget -O "$archive" "$url" 2>&1 | tee -a "$LOGFILE"
        ok=$(( ${PIPESTATUS[0]} == 0 ))
    else
        echo "+ wget -O $archive $url" >> "$LOGFILE"
        if wget -q -O "$archive" "$url" >>"$LOGFILE" 2>&1; then ok=1; else ok=0; fi
    fi
    if [[ "$ok" != 1 ]]; then die "Download failed."; fi
    step_done

    step_begin "Extracting and placing Wine into ~/.local/wine"
    start_spinner "extracting"
    mkdir -p "$HOME/.local"
    tar -xf "$archive" -C "$HOME/.local/" >>"$LOGFILE" 2>&1 || { die "Extraction failed."; }

    local extracted_folder
    extracted_folder=$(find "$HOME/.local" -maxdepth 1 -type d \( \
        -name "wine-*-staging-tkg-amd64-wow64" -o \
        -name "wine-*-staging-tkg-ntsync-amd64-wow64" -o \
        -name "wine-proton-*-amd64-wow64" \
        \) -print -quit)
    [[ -n "$extracted_folder" ]] || { die "Extracted folder not recognized."; }
    mv "$extracted_folder" "$target" >>"$LOGFILE" 2>&1 || { die "Could not place extracted folder."; }
    rm -f "$archive"
    step_done
}

##############################################################################################
# Wrappers, PATH, winetricks
##############################################################################################

create_binary_links() {
    step_begin "Creating wine wrapper and symlinks in ~/.local/bin"
    mkdir -p "$HOME/.local/bin"

    cat > "$HOME/.local/bin/wine" <<EOF
#!/usr/bin/env bash

export WINEFSYNC=1
export MANGOHUD=1
export WINEDLLOVERRIDES="glide=n,b;glide2x=n,b;glide3x=n,b;ddraw=n,b;dinput8=n,b;d3d11=n,b;d3d10=n,b;d3d8=n,b;d3d9=n,b;dxgi=n,b"

exec systemd-inhibit --what="sleep:idle" \\
    --why="Running Wine app" \\
    "$HOME/.local/wine/bin/wine" "\$@"
EOF
    chmod +x "$HOME/.local/bin/wine"
    ln -sf "$HOME/.local/wine/bin/winecfg" "$HOME/.local/bin/winecfg"
    ln -sf "$HOME/.local/wine/bin/wineserver" "$HOME/.local/bin/wineserver"
    ln -sf "$HOME/.local/wine/bin/wineboot" "$HOME/.local/bin/wineboot"
    step_done
}

add_local_bin() {
    step_begin "Adding ~/.local/bin to PATH (.profile, .xprofile)"
    local local_bin="$HOME/.local/bin"
    local profile_files=("$HOME/.profile" "$HOME/.xprofile")

    mkdir -p "$local_bin"
    if [[ ":$PATH:" != *":$local_bin:"* ]]; then
        export PATH="$local_bin:$PATH"
    fi

    for profile_file in "${profile_files[@]}"; do
        [[ -f "$profile_file" ]] || touch "$profile_file"
        if grep -qF '# Add user local binaries to PATH' "$profile_file" \
           || grep -qF 'export PATH="$HOME/.local/bin:$PATH"' "$profile_file"; then
            sub_status "already configured in $profile_file"
        else
            {
                echo ''
                echo '# Add user local binaries to PATH'
                echo 'if [ -d "$HOME/.local/bin" ]; then'
                echo '    export PATH="$HOME/.local/bin:$PATH"'
                echo 'fi'
            } >> "$profile_file"
            sub_ok "configured $profile_file"
        fi
    done
    step_done
}

install_winetricks() {
    step_begin "Installing winetricks (upstream master)"
    start_spinner "downloading"
    if (( VERBOSE )); then
        wget -O "$HOME/.local/bin/winetricks" \
            https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks 2>&1 \
            | tee -a "$LOGFILE"
    else
        echo "+ wget winetricks" >> "$LOGFILE"
        wget -q -O "$HOME/.local/bin/winetricks" \
            https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks >>"$LOGFILE" 2>&1
    fi
    if [[ ! -s "$HOME/.local/bin/winetricks" ]]; then
        die "Could not download winetricks."
    fi
    chmod +x "$HOME/.local/bin/winetricks"
    sed -i '/^#!/a export W_OPT_UNATTENDED=1' "$HOME/.local/bin/winetricks"
    sed -i '/^#!/a export WINETRICKS_LATEST_VERSION_CHECK=disabled' "$HOME/.local/bin/winetricks"
    step_done
}

##############################################################################################
# Desktop integration
##############################################################################################

WINE_MIME_TYPES=(
    application/x-ms-dos-executable
    application/x-msdownload
    application/vnd.microsoft.portable-executable
    application/x-msi
    application/x-ms-shortcut
    application/x-bat
    application/x-mswinurl
)

create_wine_launcher() {
    step_begin "Creating wine.desktop and .exe file associations"
    local desktop_file="$HOME/.local/share/applications/wine.desktop"
    mkdir -p "$(dirname "$desktop_file")"

    cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Name=Wine Windows Program Loader
Exec=$HOME/.local/bin/wine start /unix %f
MimeType=$(printf '%s;' "${WINE_MIME_TYPES[@]}")
Icon=$HOME/.local/share/icons/wine.svg
NoDisplay=false
StartupNotify=true
Terminal=false
EOF

    update-desktop-database "$HOME/.local/share/applications" >>"$LOGFILE" 2>&1

    for mime in "${WINE_MIME_TYPES[@]}"; do
        xdg-mime default wine.desktop "$mime" >>"$LOGFILE" 2>&1
    done
    step_done
}

create_wine_app_launchers() {
    step_begin "Creating winecfg, ddraw-config, and wineshortcut .desktop files"
    local apps_dir="$HOME/.local/share/applications"
    mkdir -p "$apps_dir"

    cat > "$apps_dir/winecfg.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Wine Configuration
Comment=Configure Wine settings
Exec=$HOME/.local/bin/winecfg
Icon=$HOME/.local/share/icons/winecfg.svg
Terminal=false
Categories=Settings;Utility;
EOF

    cat > "$apps_dir/ddraw-config.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=DDraw Config (cnc-ddraw)
Comment=Configure cnc-ddraw wrapper
Exec=$HOME/.local/bin/wine "$HOME/.wine/drive_c/windows/syswow64/cnc-ddraw config.exe"
Icon=$HOME/.local/share/icons/ddraw-config.svg
Terminal=false
Categories=Settings;Utility;
EOF

    cat > "$apps_dir/wineshortcut.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Create Wine Desktop Shortcut
Comment=Turn any .exe into a desktop shortcut
Exec=$HOME/.local/bin/wineshortcut
Icon=$HOME/.local/share/icons/wineshortcut.svg
Terminal=false
Categories=Utility;
EOF

    update-desktop-database "$apps_dir" >>"$LOGFILE" 2>&1
    step_done
}

install_wine_icons() {
    step_begin "Installing Numix Circle icons for Wine"
    local icons_dir="$HOME/.local/share/icons"
    mkdir -p "$icons_dir"

    local base_url="https://raw.githubusercontent.com/salvalie/SetWINE/main/src/images/icons"
    local icon_files=("wine.svg" "winecfg.svg" "wineshortcut.svg" "ddraw-config.svg")
    local ic failed=0
    for ic in "${icon_files[@]}"; do
        if ! wget -q -O "$icons_dir/$ic" "$base_url/$ic" >>"$LOGFILE" 2>&1; then
            yecho "  Failed to download $ic"
            failed=1
        fi
    done

    if (( failed )); then
        step_done
        yecho "  Some icons failed to download."
        return 0
    fi
    step_done
}

##############################################################################################
# Prefix, DXVK, helpers, hotkey, shortcuts tool
##############################################################################################

setup_prefix() {
    step_begin "Initializing Wine prefix (~/.wine)"
    if [[ ! -x "$HOME/.local/bin/wine" ]]; then
        die "wine wrapper missing, installation incomplete."
    fi
    start_spinner "wineboot --init (can take a minute)"
    echo "+ wineboot --init" >> "$LOGFILE"
    WINEDEBUG=-all "$HOME/.local/bin/wineboot" --init >>"$LOGFILE" 2>&1
    "$HOME/.local/bin/wineserver" -w 2>>"$LOGFILE"
    step_done
}

setup_dxvk() {
    show_cursor_for_prompt
    cecho "  Which DXVK version? (changeable later with winetricks)"
    cecho "    1) dxvk2041 (stable for intel)"
    cecho "    2) dxvk2051"
    cecho "    3) dxvk    (latest)"
    local option dxvk_ver
    while :; do
        if ! read -rp "  Number [1-3]: " option; then
            printf '\n'
            die "Input stream closed."
        fi
        case "$option" in
            1) dxvk_ver="dxvk2041"; break ;;
            2) dxvk_ver="dxvk2051"; break ;;
            3) dxvk_ver="dxvk"; break ;;
            *) yecho "  Invalid option, try again." ;;
        esac
    done

    step_begin "Installing $dxvk_ver + vkd3d via winetricks"
    start_spinner "winetricks (this can take a while)"
    echo "+ winetricks --force $dxvk_ver vkd3d" >> "$LOGFILE"
    if W_OPT_UNATTENDED=1 WINEDEBUG=-all "$HOME/.local/bin/winetricks" --force "$dxvk_ver" vkd3d >>"$LOGFILE" 2>&1; then
        step_done
    else
        step_done
        yecho "  DXVK/vkd3d reported problems - check the log if games misbehave."
    fi
}

setup_helpers() {
    step_begin "Installing helpers: wined (debug), winemode (wayland<->x11)"
    local bin_dir="$HOME/.local/bin"
    mkdir -p "$bin_dir"

    cat > "$bin_dir/wined" <<'EOF'
#!/usr/bin/env sh

if [ -z "$1" ]; then
    echo "Usage: wined <exe>"
    exit 1
fi

logfile="wine_full.log"
errfile="wine_err.log"

WINEDEBUG=+timestamp,+pid,+process wine "$1" >"$logfile" 2>&1

grep -iE "err:|fail|exception" "$logfile" >"$errfile"

echo "Full log: $logfile"
echo "Filtered errors: $errfile"
EOF

    cat > "$bin_dir/winemode" <<'EOF'
#!/usr/bin/env sh

current=$(
    wine reg.exe query \
        'HKCU\Software\Wine\Drivers' \
        /v Graphics 2>/dev/null |
        awk '/Graphics/ {print $NF}' |
        tr -d '\r'
)

case "$current" in
    wayland)
        echo "Wine: wayland -> x11"
        wine reg.exe add \
            'HKCU\Software\Wine\Drivers' \
            /v Graphics /d x11 /f
        ;;

    x11)
        echo "Wine: x11 -> wayland"
        wine reg.exe add \
            'HKCU\Software\Wine\Drivers' \
            /v Graphics /d wayland /f
        ;;

    *)
        echo "Wine Graphics unset -> x11"
        wine reg.exe add \
            'HKCU\Software\Wine\Drivers' \
            /v Graphics /d x11 /f
        ;;
esac
EOF

    chmod +x "$bin_dir/wined" "$bin_dir/winemode"
    step_done
}

detect_desktop_environment() {
    if [[ "$XDG_CURRENT_DESKTOP" =~ GNOME ]]; then echo "gnome"
    elif [[ "$XDG_CURRENT_DESKTOP" =~ XFCE ]]; then echo "xfce"
    elif [[ "$XDG_CURRENT_DESKTOP" =~ KDE ]]; then echo "kde"
    elif [[ "$XDG_CURRENT_DESKTOP" =~ Cinnamon ]]; then echo "cinnamon"
    elif [[ "$XDG_CURRENT_DESKTOP" =~ LXDE ]]; then echo "openbox"
    elif pgrep -x openbox >/dev/null 2>&1; then echo "openbox"
    elif [[ "$XDG_CURRENT_DESKTOP" =~ [Hh]yprland ]]; then echo "hyprland"
    elif pgrep -x Hyprland >/dev/null 2>&1; then echo "hyprland"
    elif [[ "$XDG_CURRENT_DESKTOP" =~ [Mm]ango ]]; then echo "mangowm"
    elif pgrep -x mango >/dev/null 2>&1; then echo "mangowm"
    else echo "unknown"
    fi
}

setup_wine_killer_shortcut() {
    step_begin "Creating Wine killer shortcut (Ctrl+Alt+Q -> wineserver -k)"
    local de
    de=$(detect_desktop_environment)

    case "$de" in
        gnome)
            gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/']" >>"$LOGFILE" 2>&1
            gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/ name "Wine Killer" >>"$LOGFILE" 2>&1
            gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/ command "wineserver -k" >>"$LOGFILE" 2>&1
            gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/wine-killer/ binding "<Ctrl><Alt>Q" >>"$LOGFILE" 2>&1
            step_done
            ;;
        xfce)
            xfconf-query -c xfce4-keyboard-shortcuts \
                -p "/commands/custom/<Primary><Alt>Q" \
                -n -t string -s "wineserver -k" >>"$LOGFILE" 2>&1
            step_done
            ;;
        cinnamon)
            gsettings set org.cinnamon.desktop.keybindings custom-list "['custom0']" >>"$LOGFILE" 2>&1
            gsettings set org.cinnamon.desktop.keybindings.custom-keybinding:/org/cinnamon/desktop/keybindings/custom-keybindings/custom0/ name "Wine Killer" >>"$LOGFILE" 2>&1
            gsettings set org.cinnamon.desktop.keybindings.custom-keybinding:/org/cinnamon/desktop/keybindings/custom-keybindings/custom0/ command "wineserver -k" >>"$LOGFILE" 2>&1
            gsettings set org.cinnamon.desktop.keybindings.custom-keybinding:/org/cinnamon/desktop/keybindings/custom-keybindings/custom0/ binding "['<Ctrl><Alt>q']" >>"$LOGFILE" 2>&1
            step_done
            ;;
        openbox)
            local rc=""
            if [ -f "$HOME/.config/openbox/rc.xml" ]; then
                rc="$HOME/.config/openbox/rc.xml"
            else
                for candidate in "$HOME/.config/openbox/"*rc.xml; do
                    if [ -f "$candidate" ]; then rc="$candidate"; break; fi
                done
            fi
            if [ -z "$rc" ]; then
                step_done
                yecho "  Openbox config not found, skipping hotkey."
                return 0
            fi
            if grep -q 'wineserver -k' "$rc"; then
                step_done
                sub_status "hotkey already present in Openbox config"
                return 0
            fi
            sed -i '/<\/keyboard>/i\
            <keybind key="C-A-Q">\
              <action name="Execute">\
                <command>wineserver -k</command>\
              </action>\
            </keybind>' "$rc"
            openbox --reconfigure >>"$LOGFILE" 2>&1
            step_done
            ;;
        mangowm)
            local keybinds_file="$HOME/.config/mango/cfg/keybinds.conf"
            if [[ ! -f "$keybinds_file" ]]; then
                mkdir -p "$(dirname "$keybinds_file")"
                touch "$keybinds_file"
            fi
            if grep -q 'wineserver -k' "$keybinds_file"; then
                step_done
                sub_status "hotkey already present in Mango WM config"
                return 0
            fi
            {
                echo ""
                echo "# Wine killer"
                echo "bind = CTRL+ALT, q, spawn, wineserver -k"
            } >> "$keybinds_file"
            step_done
            ;;
        hyprland)
            local hypr_config=""
            if [[ -f "$HOME/.config/hypr/hyprland.conf" ]]; then
                hypr_config="$HOME/.config/hypr/hyprland.conf"
            elif [[ -d "$HOME/.config/hypr" ]]; then
                for candidate in "$HOME/.config/hypr/"*.conf; do
                    if [[ -f "$candidate" ]]; then hypr_config="$candidate"; break; fi
                done
            fi
            if [[ -z "$hypr_config" ]]; then
                mkdir -p "$HOME/.config/hypr"
                hypr_config="$HOME/.config/hypr/hyprland.conf"
                touch "$hypr_config"
            fi
            if grep -q 'wineserver -k' "$hypr_config"; then
                step_done
                sub_status "hotkey already present in Hyprland config"
                return 0
            fi
            {
                echo ""
                echo "# Wine killer"
                echo "bind = CTRL ALT, Q, exec, wineserver -k"
            } >> "$hypr_config"
            step_done
            ;;
        *)
            step_done
            sub_status "desktop '$de' not supported yet, skipped"
            ;;
    esac
}

install_wineshortcut() {
    step_begin "Installing wineshortcut tool"
    local target="$HOME/.local/bin/wineshortcut"
    mkdir -p "$HOME/.local/bin"

    cat > "$target" <<'EOF'
#!/usr/bin/env bash

create_wine_shortcut() {
    if [[ $# -lt 2 ]]; then
        echo "Use: wineshortcut <software.exe> <DIRECT ACCESS NAME>"
        return 1
    fi

    local exe="$1"
    local name="$2"

    local cwd
    cwd="$(pwd)"
    local exe_path="$cwd/$exe"
    local base_name="${exe%.exe}"
    local launcher_path="$cwd/$base_name.sh"
    local icon_path="$cwd/icon.png"
    local wine_path="$HOME/.local/bin/wine"

    if [[ ! -f "$exe_path" ]]; then
        echo "Error: .exe not found: $exe_path"
        return 1
    fi

    # Extract icons
    local temp_dir
    temp_dir="$(mktemp -d)"
    wrestool -x --type=14 "$exe_path" -o "$temp_dir" 2>/dev/null

    shopt -s nullglob
    for ico in "$temp_dir"/*.ico; do
        convert "$ico" "${ico%.ico}.png" 2>/dev/null
    done

    local best_png=""
    local best_area=0
    for png in "$temp_dir"/*.png; do
        local dimensions
        dimensions=$(identify -format "%w %h" "$png" 2>/dev/null)
        local width height area
        read -r width height <<< "$dimensions"
        area=$((width * height))
        if (( area > best_area )); then
            best_area=$area
            best_png="$png"
        fi
    done

    if [[ -n "$best_png" ]]; then
        cp "$best_png" "$icon_path"
        echo "Icon extracted: $icon_path"
    else
        echo "Icon extracted failed: no proper images found."
    fi

    rm -rf "$temp_dir"

    # Create launcher
    cat <<EOF2 > "$launcher_path"
#!/bin/bash
cd "\$(dirname "\$0")"
#export WINEDLLOVERRIDES="example=n,b" // here you can export libraries, handy for hacks that require custom libs, example: "export WINEDLLOVERRIDES="winmm=n,b""
#export DXVK_FRAME_RATE=30 
exec "$wine_path" "$exe"
EOF2

    chmod +x "$launcher_path"

    # Determine desktop directory
    local desktop_dir=""
    local apps_dir="$HOME/.local/share/applications"
    mkdir -p "$apps_dir"

    # Check common desktop folder names
    for candidate in "$HOME/Desktop" "$HOME/Escritorio" "$HOME/schreibtisch" "$HOME/Bureau"; do
        if [[ -d "$candidate" ]]; then
            desktop_dir="$candidate"
            break
        fi
    done

    # Also check xdg-user-dir as fallback
    if [[ -z "$desktop_dir" ]]; then
        local xdg_desktop
        xdg_desktop="$(xdg-user-dir DESKTOP 2>/dev/null)"
        if [[ -n "$xdg_desktop" && -d "$xdg_desktop" ]]; then
            desktop_dir="$xdg_desktop"
        fi
    fi

    # Create .desktop content
    local desktop_content="[Desktop Entry]
Encoding=UTF-8
Version=1.0
Type=Application
Name=$name
GenericName=$name
Comment=$name
Icon=$icon_path
Exec=\"$launcher_path\"
Categories=Game;
Path=$cwd
Terminal=false"

    # Always create in ~/.local/share/applications (for app menu)
    echo "$desktop_content" > "$apps_dir/$name.desktop"
    chmod +x "$apps_dir/$name.desktop"
    echo "Shortcut created: $apps_dir/$name.desktop"

    # Also create on Desktop if it exists
    if [[ -n "$desktop_dir" ]]; then
        echo "$desktop_content" > "$desktop_dir/$name.desktop"
        chmod +x "$desktop_dir/$name.desktop"
        echo "Shortcut created: $desktop_dir/$name.desktop"
    fi
}

create_wine_shortcut "$@"
EOF

    chmod +x "$target"
    step_done
}

winetricks_dependencies() {
